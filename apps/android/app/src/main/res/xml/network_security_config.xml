<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The robot normally exposes an HTTP service only on the trusted local LAN. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
