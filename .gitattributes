# 默认把文本文件以 LF 保存到 Git 仓库
* text=auto eol=lf

# Windows 专用脚本使用 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Linux / Unix 脚本必须保持 LF
*.sh text eol=lf

# 常见源代码和配置文件统一使用 LF
*.py text eol=lf
*.c text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# 二进制文件不进行换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.pt binary
*.pth binary
*.onnx binary
*.safetensors binary