[Unit]
Description=Final Work Raspberry Pi web bridge
Wants=network-online.target
After=network-online.target bluetooth.service

[Service]
Type=simple
User=dachuang
WorkingDirectory=/home/robot/dachuang/track
Environment=PYTHONUNBUFFERED=1
ExecStart=/bin/bash /home/robot/dachuang/track/final_work/start_pi.sh
Restart=on-failure
RestartSec=3
TimeoutStopSec=8

[Install]
WantedBy=multi-user.target
