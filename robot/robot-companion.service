[Unit]
Description=Robot Companion HTTP bridge
After=network-online.target bluetooth.service
Wants=network-online.target

[Service]
Type=simple
User=dachuang
WorkingDirectory=/home/robot/dachuang/car1.0
ExecStart=/home/robot/dachuang/car1.0/companion_service.sh
# The bridge may receive SIGINT when a broad Python cleanup command is used.
# Keep the Android control endpoint available after such an interruption.
Restart=always
RestartSec=2
KillSignal=SIGINT
TimeoutStopSec=12

[Install]
WantedBy=multi-user.target
